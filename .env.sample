# ================================================================
# olivers-travel-planning — environment variables
# Copy this file to .env and fill in your keys.
# .env is gitignored and will never be committed.
# ================================================================

# --- Flights (Duffel) -------------------------------------------
# https://app.duffel.com/join
# Use duffel_test_... for simulated data (no verification needed)
# Use duffel_live_... for real flights (requires Duffel account verification)
DUFFEL_API_KEY_LIVE=duffel_test_your_key_here

# --- Google Maps ------------------------------------------------
# console.cloud.google.com → New project → Enable:
#   Maps JavaScript API, Places API, Directions API, Geocoding API
# → Credentials → Create API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Google OAuth (Calendar integration) -----------------------
# console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth 2.0 Client ID (Desktop app)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Weather (OpenWeatherMap) ----------------------------------
# openweathermap.org → Sign up → free API key (instant)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Currency (Exchange Rate API) ------------------------------
# exchangerate-api.com → free tier, instant signup
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
