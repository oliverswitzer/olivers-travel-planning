# Duffel API — get yours at https://app.duffel.com/join
# Use duffel_test_... for test mode, duffel_live_... for real flight data
DUFFEL_API_KEY_LIVE=duffel_test_your_key_here

# Google Maps API — console.cloud.google.com → Enable Maps/Places/Directions/Geocoding APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth — for Google Calendar integration
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenWeatherMap — openweathermap.org → sign up → free API key (instant)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Exchange Rate API — exchangerate-api.com → free tier, instant signup
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
